KROGER_CLIENT_ID=your_client_id
KROGER_CLIENT_SECRET=your_client_secret

# Optional: ntfy.sh phone notification. Leave blank to disable.
# The topic is a public-URL "password" — anyone who knows it can push to
# your phone. Pick something un-guessable (openssl rand -hex 8 helps).
# Override BUZZCHECK_NTFY_URL only if self-hosting an ntfy instance.
BUZZCHECK_NTFY_TOPIC=
BUZZCHECK_NTFY_URL=https://ntfy.sh
